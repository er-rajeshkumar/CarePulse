<configuration>

    <property name="LOG_PATH" value="logs" />

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- General application log (everything except the per-service SQL logs below) -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/carepulse.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/carepulse-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!--
        Routes Hibernate SQL statements to a separate file per service, e.g. logs/LogsDoctor.log,
        logs/LogsPatient.log, etc. The target file name is picked from the "logFileName" MDC value,
        which is set by ServiceSqlLoggingAspect for the currently executing *Service method.
        Only the timestamp + the SQL statement itself is written (no other application logs).
    -->
    <appender name="SQL_SIFT" class="ch.qos.logback.classic.sift.SiftingAppender">
        <discriminator>
            <key>logFileName</key>
            <defaultValue>LogsGeneral</defaultValue>
        </discriminator>
        <sift>
            <appender name="SQL-${logFileName}" class="ch.qos.logback.core.FileAppender">
                <file>${LOG_PATH}/${logFileName}.log</file>
                <append>true</append>
                <encoder>
                    <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} - %msg%n</pattern>
                </encoder>
            </appender>
        </sift>
    </appender>

    <!-- additivity=false keeps SQL out of the console/general log, it only goes to the sifted files above -->
    <logger name="org.hibernate.SQL" level="DEBUG" additivity="false">
        <appender-ref ref="SQL_SIFT" />
    </logger>

    <logger name="com.carepulse" level="DEBUG" />

    <root level="INFO">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
    </root>

</configuration>
